---
---
<section id="components" class="py-section">
  <div class="max-w-screen-xl mx-auto px-6 lg:px-16">
    <p class="font-mono text-2xs tracking-[0.3em] text-cyan/60 uppercase mb-4" data-reveal>
      Biblioteca de Componentes
    </p>
    <h2 class="font-headline text-display-lg mb-16" data-reveal>Tokens de UI</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="border border-off-wh/07 p-8 bg-card" data-reveal>
        <p class="font-mono text-2xs tracking-widest text-off-wh/25 uppercase mb-6">Botões</p>
        <div class="flex flex-wrap gap-3">
          <button class="px-6 py-3 bg-cyan text-bg font-mono text-xs tracking-[0.2em] uppercase font-semibold hover:bg-cyan/80 transition-all duration-300">
            Primário
          </button>
          <button class="px-6 py-3 bg-transparent text-off-wh/60 font-mono text-xs tracking-[0.2em] uppercase border border-off-wh/20 hover:border-gold/50 hover:text-gold transition-all duration-300">
            Contornado
          </button>
        </div>
      </div>

      <div class="border border-off-wh/07 p-8 bg-card" data-reveal data-reveal-delay="160">
        <p class="font-mono text-2xs tracking-widest text-off-wh/25 uppercase mb-6">Entrada de Texto</p>
        <div class="flex items-center gap-2 border border-off-wh/15 px-4 py-3 focus-within:border-cyan/50 transition-colors duration-300">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-off-wh/30">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input type="text" aria-label="Pesquisar tokens de identidade" placeholder="Pesquisar tokens de identidade…" class="bg-transparent text-off-wh/60 text-sm font-body placeholder:text-off-wh/20 outline-none flex-1" />
        </div>
      </div>

      <div class="border border-off-wh/07 p-8 bg-card" data-reveal data-reveal-delay="160">
        <p class="font-mono text-2xs tracking-widest text-off-wh/25 uppercase mb-6">Símbolos</p>
        <div class="grid grid-cols-3 gap-4">
          {[
            { sym: '♃', label: 'Júpiter' },
            { sym: '★', label: 'Estrela' },
            { sym: '⬡', label: 'Escudo' },
            { sym: '✦', label: 'Faísca' },
            { sym: '◎', label: 'Alvo' },
            { sym: '⬢', label: 'Hexágono' },
          ].map(({ sym, label }) => (
            <div class="flex flex-col items-center gap-1 p-3 border border-off-wh/07 hover:border-gold/30 hover:text-gold transition-all duration-300 cursor-default">
              <span class="text-2xl text-off-wh/50" aria-hidden="true">{sym}</span>
              <span class="font-mono text-2xs text-off-wh/25 tracking-widest">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>