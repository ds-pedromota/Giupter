---
---
<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
  <div class="absolute inset-0 flex items-center justify-end pr-[-5%]">
    <div class="relative w-[90vmin] h-[90vmin] max-w-[800px]">
      <div class="absolute inset-[-20%] rounded-full border border-cyan/10 scale-x-[2] scale-y-[0.3] top-1/2 -translate-y-1/2"></div>
      <div class="absolute inset-[-30%] rounded-full border border-cyan/05 scale-x-[2.4] scale-y-[0.25] top-1/2 -translate-y-1/2"></div>
      <div class="w-full h-full rounded-full bg-gradient-to-br from-[#8B6914] via-[#C4A35A] to-[#3D2B00] shadow-planet opacity-80 overflow-hidden"
           data-parallax="0.15">
        <video src="/giupter-video.mp4" autoplay loop muted playsinline class="w-full h-full object-cover"></video>
      </div>
      <div class="absolute inset-0 rounded-full bg-cyan/5 blur-3xl scale-110 animate-glow-pulse"></div>
    </div>
  </div>

  <div class="absolute inset-0 bg-hero-vignette pointer-events-none"></div>

  <div class="relative z-10 max-w-screen-xl mx-auto px-6 lg:px-16 pt-32">
    <p class="font-mono text-xs tracking-[0.3em] text-cyan/60 mb-6 uppercase opacity-0" data-reveal>
      Sistema de Identidade de Marca · v1.0
    </p>
    <h1 class="font-headline text-display-2xl leading-[0.95] mb-8 max-w-[14ch] opacity-0" data-reveal data-reveal-delay="100">
      Expandindo<br />
      Seus Horizontes<br />
      <em class="text-gold not-italic">de Negócios.</em>
    </h1>
    <p class="font-body text-off-wh/60 text-lg max-w-[42ch] mb-10 opacity-0" data-reveal data-reveal-delay="200">
      Onde a Ambição High-Tech Encontra a Expansão Estratégica.<br />
      Jiupter é o
      <span class="text-gold font-medium">'Grande Benéfico'</span>
      do seu ecossistema de crescimento.
    </p>
    <div class="flex gap-4 flex-wrap opacity-0" data-reveal data-reveal-delay="300">
      <a href="#synthesis" class="inline-flex items-center gap-2 px-7 py-3.5 bg-cyan text-bg font-mono text-xs tracking-[0.2em] uppercase font-semibold hover:bg-cyan/90 transition-colors duration-300">
        ASCENDER AGORA
      </a>
      <a href="#colors" class="inline-flex items-center gap-2 px-7 py-3.5 border border-off-wh/20 text-off-wh/60 font-mono text-xs tracking-[0.2em] uppercase hover:border-gold/50 hover:text-gold transition-all duration-300">
        VER IDENTIDADE
      </a>
    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 animate-fade-up" style="animation-delay: 1.2s">
      <span class="font-mono text-2xs tracking-[0.3em] text-off-wh/25 uppercase">Role para Explorar</span>
      <div class="w-px h-12 bg-gradient-to-b from-off-wh/20 to-transparent"></div>
    </div>
  </div>
</section>