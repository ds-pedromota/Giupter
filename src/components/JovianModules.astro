---
const modules = [
  { img: '/giupter-formas.jpg', title: 'Escala Celestial', sub: 'Motor de Expansão', colorTheme: 'cyan', desc: 'Implante motores de dados proprietários para mapear e conquistar territórios de mercado inexplorados com precisão absoluta.', tag: 'PROSPERIDADE' },
  { img: '/giupter-formas-1.jpg', title: 'Escudo Joviano', sub: 'Camada de Proteção', colorTheme: 'gold', desc: 'Arquiteturas digitais resilientes projetadas para resistir às pressões voláteis dos cenários cibernéticos modernos.', tag: 'PROTEÇÃO' },
  { img: '/giupter-formas-2.jpg', title: 'Otimização Divina', sub: 'Núcleo de Inteligência', colorTheme: 'cyan', desc: 'Marketing de performance alimentado por IA que reage à velocidade da luz para capturar a atenção global.', tag: 'OTIMISMO' }
];

const classMaps = {
  hoverBorder: { cyan: 'hover:border-cyan/30', gold: 'hover:border-gold/30' },
  tagBorder: { cyan: 'border-cyan/25', gold: 'border-gold/25' },
  tagText: { cyan: 'text-cyan', gold: 'text-gold' },
  glowBg: { cyan: 'bg-cyan/10', gold: 'bg-gold/10' },
};
---
<section id="modules" class="py-section bg-surface/50">
  <div class="max-w-screen-xl mx-auto px-6 lg:px-16">
    <p class="font-mono text-2xs tracking-[0.3em] text-cyan/60 uppercase mb-4" data-reveal>
      O Framework · Módulos Jovianos
    </p>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
      <h2 class="font-headline text-display-lg" data-reveal>
        Expansão e<br /><em class="italic text-gold">Soberania</em>
      </h2>
      <p class="font-body text-off-wh/40 text-lg self-end pb-2" data-reveal data-reveal-delay="100">
        Nossos sistemas centrais são projetados para fornecer escala, proteção e inteligência necessárias para dominância de escala planetária.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8">
      {modules.map(({ img, icon, title, sub, colorTheme, desc, tag }, i) => {
        const hoverColor = classMaps.hoverBorder[colorTheme as keyof typeof classMaps.hoverBorder];
        const tagBorderColor = classMaps.tagBorder[colorTheme as keyof typeof classMaps.tagBorder];
        const tagTextColor = classMaps.tagText[colorTheme as keyof typeof classMaps.tagText];
        const glowBgColor = classMaps.glowBg[colorTheme as keyof typeof classMaps.glowBg];
        return (
          <div class={`border bg-card p-8 relative overflow-hidden group border-off-wh/07 transition-all duration-500 ${hoverColor}`}
               data-reveal style={`--delay:${i*100}ms`}>
            <div class="absolute inset-0 bg-card/90 group-hover:bg-card/80 transition-colors duration-500 z-0"></div>
            <img src={img} alt="" class="absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-40 transition-opacity duration-500 z-0" />
            <div class="relative z-10">
              <div class="text-3xl mb-6">{icon}</div>
              <p class="font-mono text-2xs tracking-widest text-off-wh/25 uppercase mb-2">{sub}</p>
              <h3 class="font-headline text-2xl mb-4 text-off-wh">{title}</h3>
              <p class="font-body text-off-wh/40 text-sm leading-relaxed mb-6">{desc}</p>
              <span class={`inline-block px-3 py-1 border font-mono text-2xs tracking-widest uppercase ${tagBorderColor} ${tagTextColor}`}>
                {tag}
              </span>
            </div>
            <div class={`absolute bottom-0 right-0 w-24 h-24 blur-2xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500 ${glowBgColor}`}></div>
          </div>
        );
      })}
    </div>
  </div>
</section>