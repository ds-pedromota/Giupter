<section id="stats" class="py-section-sm border-y border-off-wh/07">
  <div class="max-w-screen-xl mx-auto px-6 lg:px-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-0 divide-x divide-off-wh/07">
      {[
        { value: '322', unit: '%',       label: 'Velocidade de Mercado',  color: 'text-gold' },
        { value: '99.9',unit: '%',       label: 'Integridade do Escudo', color: 'text-off-wh' },
        { value: '14',  unit: ' Sistemas',label: 'Extensão da Rede',     color: 'text-cyan' },
        { value: '2.4', unit: ' PB',     label: 'Capacidade Neural',  color: 'text-off-wh' },
      ].map(({ value, unit, label, color }, i) => (
        <div class="px-8 py-10 text-center" data-reveal style={`--delay:${i*80}ms`}>
          <p class="font-mono text-2xs tracking-widest text-off-wh/25 uppercase mb-2">{label}</p>
          <p class={`font-headline text-5xl lg:text-6xl ${color} tabular-nums`} data-count={value}>
            0
          </p>
          <span class="text-2xl text-off-wh/40">{unit}</span>
          <div class={`w-8 h-px mx-auto mt-4 ${color === 'text-gold' ? 'bg-gold/60' : color === 'text-cyan' ? 'bg-cyan/60' : 'bg-off-wh/20'}`}></div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const stats = document.querySelectorAll('[data-count]');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const target = entry.target;
        const endValue = parseFloat(target.getAttribute('data-count') || '0');
        const isFloat = (target.getAttribute('data-count') || '').includes('.');
        const duration = 2000; // Duração da animação em milissegundos (2s)
        let startTimestamp: number | null = null;

        const step = (timestamp: number) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const progress = Math.min((timestamp - startTimestamp) / duration, 1);
          const easeOut = 1 - Math.pow(1 - progress, 4); // Desacelera no final
          const currentVal = easeOut * endValue;
          
          target.textContent = isFloat ? currentVal.toFixed(1) : Math.floor(currentVal).toString();

          if (progress < 1) {
            window.requestAnimationFrame(step);
          } else {
            target.textContent = endValue.toString();
          }
        };

        window.requestAnimationFrame(step);
        observer.unobserve(target); // Garante que anime apenas na primeira vez que aparecer
      }
    });
  }, { threshold: 0.5 });

  stats.forEach(stat => observer.observe(stat));
</script>